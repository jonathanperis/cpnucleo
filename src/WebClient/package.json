{
  "name": "cpnucleo-webclient",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.11",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node ./node_modules/astro/astro.js dev --host 0.0.0.0 --port 5030",
    "build": "node ./node_modules/astro/astro.js build",
    "preview": "node scripts/preview.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "postinstall": "node scripts/patch-qwikdev-astro.mjs",
    "prebuild": "node scripts/patch-qwikdev-astro.mjs"
  },
  "dependencies": {
    "@builder.io/qwik": "^1.16.0",
    "@qwikdev/astro": "^0.8.3",
    "astro": "5.9.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.10.1",
    "autoprefixer": "^10.4.22",
    "ignore": "^7.0.5",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "undici": "^7.16.0",
    "vitest": "^3.2.4"
  }
}
