---
import Icon from './Icon.astro';
const options = [
  { value: 'light', label: 'Paper', icon: 'sun' },
  { value: 'dark', label: 'Night', icon: 'moon' },
  { value: 'system', label: 'System', icon: 'monitor' },
] as const;
---
<details data-theme-menu class="menu relative">
  <summary class="btn btn-ghost btn-icon list-none [&::-webkit-details-marker]:hidden" aria-label="Theme" title="Theme">
    <span data-theme-icon="light"><Icon name="sun" /></span>
    <span data-theme-icon="dark" hidden><Icon name="moon" /></span>
  </summary>
  <div class="menu-panel right-0 w-40" role="group" aria-label="Theme">
    {options.map(option => (
      <button type="button" data-theme-choice={option.value} aria-pressed="false" class="menu-item"><Icon name={option.icon} />{option.label}</button>
    ))}
  </div>
</details>
<script>
  import { applyThemePreference, readThemePreference, type ThemePreference } from '../lib/ui/theme';
  import { installMenuBehavior } from '../lib/ui/menus';
  installMenuBehavior();
  const menus = document.querySelectorAll<HTMLDetailsElement>('[data-theme-menu]');
  const update = () => {
    const preference = readThemePreference();
    const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    for (const menu of menus) {
      menu.querySelector<HTMLElement>('[data-theme-icon="light"]')!.hidden = theme !== 'light';
      menu.querySelector<HTMLElement>('[data-theme-icon="dark"]')!.hidden = theme !== 'dark';
      // Spoken names match the menu: Paper (light) and Night (dark).
      const name = theme === 'light' ? 'paper' : 'night';
      const label = preference === 'system' ? `system (${name})` : name;
      menu.querySelector('summary')!.setAttribute('aria-label', `Theme: ${label}`);
      for (const choice of menu.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')) choice.setAttribute('aria-pressed', String(choice.dataset.themeChoice === preference));
    }
  };
  for (const menu of menus) {
    menu.addEventListener('click', event => {
      const choice = (event.target as Element).closest<HTMLButtonElement>('[data-theme-choice]');
      if (!choice) return;
      applyThemePreference(choice.dataset.themeChoice as ThemePreference);
      update();
      menu.open = false;
      menu.querySelector('summary')?.focus();
    });
  }
  // "System" follows the operating system while the page is open.
  window.matchMedia?.('(prefers-color-scheme: light)').addEventListener('change', () => {
    if (readThemePreference() === 'system') applyThemePreference('system');
    update();
  });
  update();
</script>
