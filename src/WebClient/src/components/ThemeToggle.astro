---
import Icon from './Icon.astro';
---
<button type="button" data-theme-toggle class="btn btn-ghost btn-icon" aria-label="Switch to light mode" title="Switch to light mode">
  <span data-theme-icon="light"><Icon name="sun" /></span>
  <span data-theme-icon="dark" hidden><Icon name="moon" /></span>
</button>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const update = () => {
    const dark = document.documentElement.dataset.theme === 'dark';
    const label = `Switch to ${dark ? 'light' : 'dark'} mode`;
    for (const button of buttons) {
      button.setAttribute('aria-label', label);
      button.title = label;
      // Show the theme the button switches to.
      button.querySelector<HTMLElement>('[data-theme-icon="light"]')!.hidden = !dark;
      button.querySelector<HTMLElement>('[data-theme-icon="dark"]')!.hidden = dark;
    }
  };
  for (const button of buttons) button.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    localStorage.setItem('cpnucleo-theme', theme);
    update();
  });
  update();
</script>
