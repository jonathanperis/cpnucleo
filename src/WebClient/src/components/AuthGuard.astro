<div data-auth-content hidden><slot /></div>
<p data-auth-loading role="status" class="p-6 text-muted">Checking your session…</p>
<noscript><p class="p-6 text-danger">JavaScript is required to sign in and use this learning workspace.</p></noscript>
<script>
  import { detectDuplicatedTab, getStoredToken, hasExpiredSession, redirectToLoginForExpiredSession, setupSessionActivityTracking, signOut } from '../lib/api/http-client';
  import { getLoginRedirectTarget } from '../lib/auth-navigation';
  let stop = () => {};
  const initialize = () => {
    stop();
    if (!getStoredToken()) {
      // An expired session also ends the identity session; otherwise its cookie would sign straight back in.
      if (hasExpiredSession()) redirectToLoginForExpiredSession();
      else window.location.replace(getLoginRedirectTarget(window.location));
      return;
    }
    document.querySelectorAll<HTMLElement>('[data-auth-content]').forEach(element => { element.hidden = false; });
    document.querySelectorAll<HTMLElement>('[data-auth-loading]').forEach(element => { element.hidden = true; });
    stop = setupSessionActivityTracking();
    // A tab copied from another (with its sessionStorage) signs in for its own tokens.
    void detectDuplicatedTab().then(duplicate => { if (duplicate) window.location.replace(getLoginRedirectTarget(window.location)); });
  };
  // signOut() revokes the refresh token, signs out the other tabs (BroadcastChannel, storage-event
  // fallback) and ends the identity session through the end-session endpoint.
  document.querySelector('[data-logout]')?.addEventListener('click', () => { void signOut(); });
  window.addEventListener('pagehide', () => stop());
  window.addEventListener('pageshow', event => { if (event.persisted) initialize(); });
  initialize();
</script>
