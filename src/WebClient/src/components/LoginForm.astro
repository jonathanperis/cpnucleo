<section class="w-full max-w-md rounded-[2rem] border border-line bg-surface/95 p-6 shadow-soft sm:p-8">
  <p class="text-sm font-semibold text-accent">Sign in</p><h2 class="mt-2 text-3xl font-semibold">Welcome back</h2>
  <p class="mt-3 text-sm text-muted">Enter your Cpnucleo credentials to open the learning workspace.</p>
  <p data-login-error role="alert" hidden class="mt-5 rounded-xl border border-danger/25 px-4 py-3 text-sm text-danger"></p>
  <p data-login-status role="status" class="mt-5 text-sm text-success"></p>
  <form data-login-form class="mt-6 space-y-5">
    <label class="block"><span class="mb-2 block text-sm font-semibold">Login</span><input required name="login" autocomplete="username" class="w-full rounded-xl border border-line bg-raised px-4 py-3" /></label>
    <label class="block"><span class="mb-2 block text-sm font-semibold">Password</span><input required name="password" type="password" autocomplete="current-password" class="w-full rounded-xl border border-line bg-raised px-4 py-3" /></label>
    <button type="submit" class="w-full rounded-xl bg-ink px-4 py-3 font-semibold text-canvas disabled:opacity-50">Enter dashboard</button>
  </form>
</section>
<script>
  import { mountLoginForm } from '../features/auth/login-controller';
  mountLoginForm(document.querySelector<HTMLFormElement>('[data-login-form]')!);
</script>
