---
import Icon from './Icon.astro';
---
<section class="w-full max-w-sm">
  <h1 class="text-2xl font-semibold tracking-tight">Sign in</h1>
  <p class="mt-2 text-sm leading-relaxed text-muted">Use your Cpnucleo account to open the workspace.</p>
  <p data-login-error role="alert" hidden class="reveal mt-6 rounded-lg border border-danger/30 bg-danger/10 px-3.5 py-3 text-sm text-danger"></p>
  <p data-login-status role="status" class="mt-6 text-sm text-success empty:mt-0"></p>
  <form data-login-form class="mt-6 space-y-4">
    <div>
      <label for="login-name" class="mb-1.5 block text-[0.8125rem] font-medium">Login</label>
      <input id="login-name" required name="login" autocomplete="username" autocapitalize="none" spellcheck="false" class="field h-11" />
    </div>
    <div>
      <label for="login-password" class="mb-1.5 block text-[0.8125rem] font-medium">Password</label>
      <input id="login-password" required name="password" type="password" autocomplete="current-password" class="field h-11" />
    </div>
    <button type="submit" class="btn btn-primary h-11 w-full text-[0.9375rem]">Enter dashboard</button>
  </form>
  <p class="mt-6 flex items-start gap-2 text-xs leading-relaxed text-subtle"><Icon name="shield" class="mt-px size-3.5 flex-none" />Sessions stay in this tab and end after 15 minutes without activity.</p>
</section>
<script>
  import { mountLoginForm } from '../features/auth/login-controller';
  mountLoginForm(document.querySelector<HTMLFormElement>('[data-login-form]')!);
</script>
