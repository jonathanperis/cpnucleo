---
import '../global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import AuthGuard from '../components/AuthGuard.astro';
import BrandMark from '../components/BrandMark.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Icon from '../components/Icon.astro';
import RequestInspector from '../components/RequestInspector.astro';
import SessionWarning from '../components/SessionWarning.astro';
import SidebarNav from '../components/SidebarNav.astro';
import { locate } from '../lib/navigation';
import { WEBAPI_BASE_URL } from '../lib/config';

interface Props { path?: string; title?: string }
const { path = '/', title } = Astro.props;
const location = locate(path);
const pageTitle = title ?? location?.item.label;
const local = WEBAPI_BASE_URL.startsWith('http://localhost:');
const apiHost = new URL(WEBAPI_BASE_URL).host;
---

<html lang="en" data-theme="dark" style="color-scheme: dark;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle ? `${pageTitle} · Cpnucleo` : 'Cpnucleo'}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('cpnucleo-theme');
          // Dark unless the person chose light, or chose to follow the operating system.
          const theme = stored === 'dark' || stored === 'light'
            ? stored
            : stored === 'system' && window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only z-50 rounded-md bg-accent px-3 py-2 text-sm font-semibold text-accent-ink focus:not-sr-only focus:fixed focus:left-4 focus:top-3">Skip to content</a>
    <div class="min-h-screen text-ink">
      <aside class="fixed inset-y-0 left-0 z-40 hidden w-64 flex-col border-r border-line bg-surface/50 lg:flex">
        <a href="/" class="flex h-16 items-center gap-3 px-5">
          <BrandMark />
          <span class="leading-tight">
            <span class="block text-[0.9375rem] font-semibold tracking-tight">Cpnucleo</span>
            <span class="block text-xs text-subtle">Project workspace</span>
          </span>
        </a>
        <div class="quiet-scroll flex-1 overflow-y-auto px-3 pb-6 pt-4">
          <SidebarNav path={path} idPrefix="sidebar" />
        </div>
        <div class="border-t border-line px-5 py-4" title={WEBAPI_BASE_URL}>
          <p class="flex items-center gap-2 text-xs font-medium text-muted"><span class:list={['status-dot', local ? 'text-success' : 'text-accent']}></span>{local ? 'Local learning sandbox' : 'Remote API workspace'}</p>
          <p class="mt-1 truncate pl-4 font-mono text-[0.6875rem] text-subtle">{apiHost}</p>
        </div>
      </aside>
      <div class="lg:pl-64">
        <header class="sticky top-0 z-30 border-b border-line bg-canvas/95">
          <div class="flex h-14 items-center gap-2 px-4 sm:gap-3 sm:px-6 lg:px-10">
            <details data-mobile-menu class="lg:hidden">
              <summary class="btn btn-ghost btn-icon list-none [&::-webkit-details-marker]:hidden" aria-label="Navigation menu"><Icon name="menu" class="size-5" /></summary>
              <div class="fixed inset-x-0 bottom-0 top-14 z-50 overflow-y-auto border-t border-line bg-surface px-3 py-5">
                <SidebarNav path={path} idPrefix="menu" />
                <p class="mt-6 flex items-center gap-2 px-2.5 text-xs text-muted" title={WEBAPI_BASE_URL}><span class:list={['status-dot', local ? 'text-success' : 'text-accent']}></span>{local ? 'Local learning sandbox' : 'Remote API workspace'}</p>
              </div>
            </details>
            <a href="/" class="lg:hidden" aria-label="Cpnucleo home"><BrandMark class="size-8" /></a>
            <nav aria-label="Breadcrumb" class="min-w-0 flex-1">
              <ol class="flex min-w-0 items-center gap-2 text-sm">
                {location && location.item.href !== '/' && <li class="hidden text-subtle sm:block">{location.group.name}</li>}
                {location && location.item.href !== '/' && <li aria-hidden="true" class="hidden text-line-strong sm:block">/</li>}
                <li class="truncate font-medium" aria-current="page" data-breadcrumb-current>{pageTitle ?? 'Home'}</li>
              </ol>
            </nav>
            <div class="flex items-center gap-1">
              <button type="button" data-open-palette class="search-trigger" aria-keyshortcuts="Control+K Meta+K">
                <Icon name="search" class="size-4" /><span class="hidden md:inline">Search</span><kbd class="kbd hidden md:inline-flex" data-shortcut-hint>Ctrl K</kbd>
              </button>
              <button type="button" data-toggle-inspector aria-expanded="false" class="btn btn-ghost btn-icon" title="API requests" aria-label="API requests"><Icon name="network" /></button>
              <ThemeToggle />
              <span class="mx-1 hidden h-6 w-px bg-line sm:block" aria-hidden="true"></span>
              <details data-session hidden class="menu relative">
                <summary class="flex cursor-pointer list-none items-center gap-2.5 rounded-lg p-1 hover:bg-raised [&::-webkit-details-marker]:hidden" aria-label="Your account">
                  <span data-session-initial aria-hidden="true" class="flex size-8 items-center justify-center rounded-full bg-raised text-xs font-semibold uppercase text-muted ring-1 ring-line-strong"></span>
                  <span class="hidden pr-1 leading-tight md:block">
                    <span data-session-login class="block max-w-48 truncate text-[0.8125rem] font-medium"></span>
                    <span data-session-role class="block text-[0.6875rem] text-subtle"></span>
                  </span>
                </summary>
                <div class="menu-panel right-0 w-56">
                  <p class="truncate px-3 pb-2 pt-1.5 text-xs text-subtle md:hidden" data-session-login-menu></p>
                  <a href="/account/" class="menu-item"><Icon name="user" />Your account</a>
                  <button type="button" data-logout class="menu-item"><Icon name="logOut" />Sign out</button>
                </div>
              </details>
            </div>
          </div>
        </header>
        <main id="main" class="mx-auto w-full max-w-7xl px-4 pb-16 pt-8 sm:px-6 lg:px-10"><AuthGuard><slot /></AuthGuard></main>
      </div>
    </div>
    <div data-toasts role="region" aria-label="Notifications" aria-live="polite" class="toasts"></div>
    <RequestInspector />
    <CommandPalette />
    <SessionWarning />
  </body>
</html>
<script>
  import { getSessionClaims } from '../lib/api/http-client';
  import { installMenuBehavior } from '../lib/ui/menus';
  installMenuBehavior();
  const session = getSessionClaims();
  const container = document.querySelector<HTMLElement>('[data-session]');
  if (session && container) {
    container.querySelector<HTMLElement>('[data-session-initial]')!.textContent = session.login.trim().charAt(0) || '?';
    container.querySelector<HTMLElement>('[data-session-login]')!.textContent = session.login;
    container.querySelector<HTMLElement>('[data-session-login-menu]')!.textContent = session.login;
    container.querySelector<HTMLElement>('[data-session-role]')!.textContent = session.isAdmin ? 'Administrator' : 'Member';
    container.title = session.login;
    container.hidden = false;
  }
  if (/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelectorAll('[data-shortcut-hint]').forEach(hint => { hint.textContent = '⌘ K'; });
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.open) { menu.open = false; menu.querySelector('summary')?.focus(); }
  });
</script>
