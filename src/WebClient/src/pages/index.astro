---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
import { findResource } from '../lib/api/resource-metadata';
import { navigation } from '../lib/navigation';

const areas = navigation
  .map(group => ({ name: group.name, items: group.items.filter(item => item.resource).map(item => ({ ...item, resource: findResource(item.resource!) })) }))
  .filter(group => group.items.length > 0);
---
<AppLayout path="/" title="Home">
  <div data-home class="space-y-10">
    <section class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow">Workspace overview</p>
        <h1 data-greeting class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-[2.125rem]">Welcome back</h1>
        <p class="mt-2 max-w-xl text-[0.9375rem] leading-relaxed text-muted">Your open work first, then every area of the learning workspace. Each list is served by the same API you can inspect, test and reset locally.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class="btn btn-primary" href="/board/"><Icon name="board" />Open board</a>
        <a class="btn btn-secondary" href="/appointments/?new=1"><Icon name="clock" />Log time</a>
        <a class="btn btn-ghost" href="https://jonathanperis.github.io/cpnucleo/docs/learning-lab/"><Icon name="book" />Learning paths</a>
      </div>
    </section>

    <section data-my-work aria-labelledby="my-work-heading" aria-busy="true" class="grid gap-5 lg:grid-cols-3">
      <h2 id="my-work-heading" class="sr-only">My work</h2>
      <div class="panel overflow-hidden lg:col-span-2 lg:row-span-2">
        <div class="flex items-center justify-between gap-3 border-b border-line px-5 py-3">
          <p class="eyebrow">Your open tasks</p>
          <a data-my-tasks-all href="/assignments/" class="btn btn-ghost btn-sm">All your tasks<Icon name="arrowRight" /></a>
        </div>
        <dl class="grid grid-cols-3 divide-x divide-line border-b border-line">
          <div class="px-5 py-3"><dt class="text-xs text-subtle">Open</dt><dd data-my-stat="open" class="mt-0.5 font-mono text-xl tabular-nums">—</dd></div>
          <div class="px-5 py-3"><dt class="text-xs text-subtle">Overdue</dt><dd data-my-stat="overdue" class="mt-0.5 font-mono text-xl tabular-nums">—</dd></div>
          <div class="px-5 py-3"><dt class="text-xs text-subtle">Due in 7 days</dt><dd data-my-stat="soon" class="mt-0.5 font-mono text-xl tabular-nums">—</dd></div>
        </dl>
        <ul data-my-tasks class="divide-y divide-line/70"><li class="px-5 py-4"><span class="skeleton block h-4 w-2/3"></span></li></ul>
      </div>
      <div class="panel p-5">
        <div class="flex items-center justify-between gap-3">
          <p class="eyebrow">Your hours this week</p>
          <a href="/calendar/" class="btn btn-ghost btn-sm">Calendar<Icon name="arrowRight" /></a>
        </div>
        <p class="mt-3 font-mono text-3xl font-medium tabular-nums"><span data-my-hours>—</span><span class="text-base text-subtle"> h</span></p>
        <p data-my-hours-note class="mt-1 text-xs text-subtle">&nbsp;</p>
      </div>
      <div class="panel overflow-hidden">
        <p class="eyebrow border-b border-line px-5 py-3">Your projects</p>
        <ul data-my-projects class="quiet-scroll max-h-56 divide-y divide-line/70 overflow-y-auto py-1"><li class="px-5 py-3"><span class="skeleton block h-4 w-1/2"></span></li></ul>
      </div>
    </section>

    <section aria-labelledby="work-areas-heading" aria-busy="true" data-work-areas>
      <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
        <h2 id="work-areas-heading" class="text-lg font-semibold tracking-tight">Work areas</h2>
        <p class="text-xs text-subtle">Record counts per area · Dark by default · light-ready</p>
      </div>
      <p data-home-summary role="status" class="sr-only"></p>
      <div class="grid gap-5 lg:grid-cols-2">
        {areas.map((group, index) => (
          <div class:list={['panel overflow-hidden', index === 0 && 'lg:row-span-2']}>
            <p class="eyebrow border-b border-line px-5 py-3">{group.name}</p>
            <ul class="divide-y divide-line/70">
              {group.items.map(item => (
                <li>
                  <a href={item.href} class="group flex items-center gap-4 px-5 py-4 transition-colors hover:bg-raised/45">
                    <span class="flex size-9 flex-none items-center justify-center rounded-lg bg-raised text-muted ring-1 ring-line transition-colors group-hover:text-accent-text group-hover:ring-accent/30"><Icon name={item.icon} class="size-[1.125rem]" /></span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm font-medium">{item.resource.pluralLabel}</span>
                      <span class="mt-0.5 block truncate text-xs text-subtle">{item.resource.description}</span>
                    </span>
                    <span data-count={item.resource.key} class="flex-none text-right font-mono text-sm tabular-nums text-muted">—</span>
                    <Icon name="chevronRight" class="size-4 flex-none text-subtle transition-transform group-hover:translate-x-0.5 group-hover:text-muted" />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="explore-heading" class="panel grid gap-px overflow-hidden bg-line sm:grid-cols-3">
      <h2 id="explore-heading" class="sr-only">Explore the system</h2>
      <a href="/api-health/" class="group flex gap-4 bg-surface p-5 transition-colors hover:bg-raised/45">
        <Icon name="activity" class="mt-0.5 size-5 flex-none text-subtle group-hover:text-accent-text" />
        <span><span class="block text-sm font-medium">Service health</span><span class="mt-1 block text-xs leading-relaxed text-subtle">Liveness and readiness of WebApi and IdentityApi.</span></span>
      </a>
      <a href="/workflows/" class="group flex gap-4 bg-surface p-5 transition-colors hover:bg-raised/45">
        <Icon name="steps" class="mt-0.5 size-5 flex-none text-subtle group-hover:text-accent-text" />
        <span><span class="block text-sm font-medium">Progress steps</span><span class="mt-1 block text-xs leading-relaxed text-subtle">The ordered path every task moves through.</span></span>
      </a>
      <a href="https://github.com/jonathanperis/cpnucleo" class="group flex gap-4 bg-surface p-5 transition-colors hover:bg-raised/45">
        <Icon name="external" class="mt-0.5 size-5 flex-none text-subtle group-hover:text-accent-text" />
        <span><span class="block text-sm font-medium">Inspect the source</span><span class="mt-1 block text-xs leading-relaxed text-subtle">REST and gRPC, EF Core and Dapper, side by side.</span></span>
      </a>
    </section>
  </div>
</AppLayout>
<script>
  import { loadHomeCounters } from '../features/home/counters';
  import { loadMyWork } from '../features/home/my-work';
  import { getStoredToken } from '../lib/api/http-client';
  let controller = new AbortController();
  const start = () => {
    controller = new AbortController();
    const root = document.querySelector<HTMLElement>('[data-home]')!;
    if (!getStoredToken()) return;
    void loadMyWork(root, controller.signal);
    void loadHomeCounters(root, controller.signal);
  };
  start();
  window.addEventListener('pagehide', () => controller.abort());
  // Back/forward cache restores the page with aborted counters: load them again.
  window.addEventListener('pageshow', event => { if (event.persisted) start(); });
</script>
