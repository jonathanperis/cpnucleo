---
import AppLayout from '../layouts/AppLayout.astro';
import Icon from '../components/Icon.astro';
---
<AppLayout path="/calendar/" title="Calendar">
  <section data-calendar aria-labelledby="calendar-heading" class="space-y-6">
    <header class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div class="flex items-start gap-4">
        <span class="mt-1 hidden size-11 flex-none items-center justify-center rounded-xl bg-raised text-accent-text ring-1 ring-line-strong sm:flex"><Icon name="calendar" class="size-5" /></span>
        <div>
          <p class="eyebrow">Start</p>
          <h1 id="calendar-heading" class="mt-1.5 page-title">Calendar</h1>
          <p class="mt-1.5 text-[0.9375rem] text-muted">Time logged against tasks, one week at a time. Days and times are in UTC, like the forms.</p>
        </div>
      </div>
      <a href="/appointments/?new=1" class="btn btn-primary self-start sm:self-auto"><Icon name="clock" />Log time</a>
    </header>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <div class="flex items-center gap-1" role="group" aria-label="Week">
        <button type="button" data-week="previous" class="btn btn-secondary btn-icon" aria-label="Previous week"><Icon name="chevronLeft" /></button>
        <button type="button" data-week="today" class="btn btn-secondary btn-sm">This week</button>
        <button type="button" data-week="next" class="btn btn-secondary btn-icon" aria-label="Next week"><Icon name="chevronRight" /></button>
      </div>
      <p data-calendar-range class="text-sm font-medium tabular-nums"></p>
      <label class="flex items-center gap-2 text-sm text-muted"><input type="checkbox" data-calendar-mine class="checkbox" checked />Only my time</label>
      <p data-calendar-status role="status" class="text-[0.8125rem] text-subtle sm:ml-auto"></p>
    </div>
    <p data-calendar-error role="alert" hidden class="rounded-lg border border-danger/30 bg-danger/10 px-4 py-3 text-sm text-danger"></p>
    <div data-calendar-days aria-busy="true" class="calendar-week"></div>
  </section>
</AppLayout>
<script>
  import { mountCalendar } from '../features/calendar/calendar-controller';
  import { getStoredToken } from '../lib/api/http-client';
  let stop = () => {};
  const start = () => { stop(); if (getStoredToken()) stop = mountCalendar(document.querySelector<HTMLElement>('[data-calendar]')!); };
  start();
  window.addEventListener('pagehide', () => stop());
  window.addEventListener('pageshow', event => { if (event.persisted) start(); });
</script>
