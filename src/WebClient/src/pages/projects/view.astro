---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
const stats = [
  { key: 'tasks', label: 'Tasks' },
  { key: 'open', label: 'Open' },
  { key: 'overdue', label: 'Overdue' },
  { key: 'members', label: 'Members' },
  { key: 'hours', label: 'Planned hours' },
];
---
<AppLayout path="/projects/view/" title="Project">
  <div data-project-view class="space-y-8">
    <p data-view-error role="alert" hidden class="rounded-lg border border-danger/30 bg-danger/10 px-4 py-3 text-sm text-danger"></p>
    <div data-view-body aria-busy="true" class="space-y-8">
      <header class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
        <div class="flex items-start gap-4">
          <span class="mt-1 hidden size-11 flex-none items-center justify-center rounded-xl bg-raised text-accent-text ring-1 ring-line-strong sm:flex"><Icon name="folder" class="size-5" /></span>
          <div class="min-w-0">
            <p class="eyebrow"><a href="/projects/" class="hover:text-ink">Projects</a></p>
            <h1 data-title tabindex="-1" class="mt-1.5 text-2xl font-semibold tracking-tight sm:text-[1.75rem]"><span class="skeleton inline-block h-7 w-56 align-middle"></span></h1>
            <p data-organization class="mt-1.5 text-[0.9375rem] text-muted">&nbsp;</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <a data-href="/board/?projectId={id}" href="/board/" class="btn btn-secondary"><Icon name="board" />Board</a>
          <a data-href="/projects/?edit={id}" href="/projects/" class="btn btn-secondary"><Icon name="pencil" />Edit</a>
          <a data-href="/assignments/?projectId={id}&new=1" href="/assignments/" class="btn btn-primary"><Icon name="plus" />New task</a>
        </div>
      </header>

      <dl class="panel grid grid-cols-2 gap-px overflow-hidden bg-line sm:grid-cols-5">
        {stats.map(stat => (
          <div class="bg-surface px-5 py-4"><dt class="text-xs text-subtle">{stat.label}</dt><dd data-stat={stat.key} class="mt-1 font-mono text-xl font-medium tabular-nums">—</dd></div>
        ))}
      </dl>

      <div class="grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
        <section aria-labelledby="project-tasks" class="panel overflow-hidden">
          <div class="flex items-center justify-between gap-3 border-b border-line px-5 py-3">
            <h2 id="project-tasks" class="text-sm font-semibold">Tasks</h2>
            <a data-href="/assignments/?projectId={id}" href="/assignments/" class="btn btn-ghost btn-sm">Open in Tasks<Icon name="arrowRight" /></a>
          </div>
          <ul data-tasks class="divide-y divide-line/70"><li class="px-5 py-4"><span class="skeleton block h-4 w-2/3"></span></li></ul>
        </section>
        <section aria-labelledby="project-members" class="panel self-start overflow-hidden">
          <div class="flex items-center justify-between gap-3 border-b border-line px-5 py-3">
            <h2 id="project-members" class="text-sm font-semibold">Members</h2>
            <a data-href="/user-projects/?projectId={id}" href="/user-projects/" class="btn btn-ghost btn-sm">Manage<Icon name="arrowRight" /></a>
          </div>
          <ul data-members class="divide-y divide-line/70"><li class="px-5 py-4"><span class="skeleton block h-4 w-1/2"></span></li></ul>
        </section>
      </div>
    </div>
  </div>
</AppLayout>
<script>
  import { mountProjectView } from '../../features/records/project-view';
  import { getStoredToken } from '../../lib/api/http-client';
  let controller = new AbortController();
  const start = () => {
    controller.abort(); controller = new AbortController();
    const root = document.querySelector<HTMLElement>('[data-project-view]')!;
    if (getStoredToken()) void mountProjectView(root, new URLSearchParams(location.search).get('id'), controller.signal);
  };
  start();
  window.addEventListener('pagehide', () => controller.abort());
  window.addEventListener('pageshow', event => { if (event.persisted) start(); });
</script>
