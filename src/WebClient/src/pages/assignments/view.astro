---
import AppLayout from '../../layouts/AppLayout.astro';
import Icon from '../../components/Icon.astro';
---
<AppLayout path="/assignments/view/" title="Task">
  <div data-task-view class="space-y-8">
    <p data-view-error role="alert" hidden class="rounded-lg border border-danger/30 bg-danger/10 px-4 py-3 text-sm text-danger"></p>
    <div data-view-body aria-busy="true" class="space-y-8">
      <header class="flex flex-col justify-between gap-5 lg:flex-row lg:items-end">
        <div class="flex items-start gap-4">
          <span class="mt-1 hidden size-11 flex-none items-center justify-center rounded-xl bg-raised text-accent-text ring-1 ring-line-strong sm:flex"><Icon name="task" class="size-5" /></span>
          <div class="min-w-0">
            <p class="eyebrow"><a href="/assignments/" class="hover:text-ink">Tasks</a></p>
            <h1 data-title tabindex="-1" class="mt-1.5 page-title"><span class="skeleton inline-block h-7 w-56 align-middle"></span></h1>
            <p data-description class="mt-1.5 max-w-2xl whitespace-pre-line text-[0.9375rem] text-muted"></p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          <a data-href="/board/?projectId={projectId}" href="/board/" class="btn btn-secondary"><Icon name="board" />Board</a>
          <a data-href="/assignments/?edit={id}" href="/assignments/" class="btn btn-secondary"><Icon name="pencil" />Edit</a>
          <a data-href="/appointments/?assignmentId={id}&new=1" href="/appointments/" class="btn btn-primary"><Icon name="clock" />Log time</a>
        </div>
      </header>

      <div class="grid gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <section aria-labelledby="task-facts" class="panel overflow-hidden">
          <h2 id="task-facts" class="border-b border-line px-5 py-3 text-sm font-semibold">Details</h2>
          <dl data-facts class="divide-y divide-line/70 px-5 py-1"><div class="py-4"><span class="skeleton block h-4 w-2/3"></span></div></dl>
        </section>
        <section aria-labelledby="task-hours" class="panel self-start p-5">
          <h2 id="task-hours" class="text-sm font-semibold">Hours</h2>
          <p class="mt-3 stat-num text-[2.25rem]"><span data-hours-logged>—</span><span class="text-base text-subtle"> / <span data-hours-estimate>—</span> h</span></p>
          <div data-hours-bar role="meter" aria-label="Hours logged against the estimate" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" class="mt-3 h-2 overflow-hidden rounded-full bg-raised">
            <div data-hours-meter class="h-full rounded-full bg-accent transition-[width]" style="width: 0%"></div>
          </div>
          <p data-hours-note class="mt-2 text-xs text-subtle"></p>
        </section>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        <section aria-labelledby="task-blockers" class="panel self-start overflow-hidden">
          <div class="flex items-center justify-between gap-3 border-b border-line px-5 py-3">
            <h2 id="task-blockers" class="text-sm font-semibold">Blockers</h2>
            <a data-href="/assignment-impediments/?assignmentId={id}&new=1" href="/assignment-impediments/" class="btn btn-ghost btn-sm"><Icon name="plus" />Add</a>
          </div>
          <ul data-blockers class="divide-y divide-line/70"></ul>
        </section>
        <section aria-labelledby="task-people" class="panel self-start overflow-hidden">
          <div class="flex items-center justify-between gap-3 border-b border-line px-5 py-3">
            <h2 id="task-people" class="text-sm font-semibold">People on this task</h2>
            <a data-href="/user-assignments/?assignmentId={id}" href="/user-assignments/" class="btn btn-ghost btn-sm">Manage<Icon name="arrowRight" /></a>
          </div>
          <ul data-people class="divide-y divide-line/70"></ul>
        </section>
        <section aria-labelledby="task-entries" class="panel self-start overflow-hidden">
          <div class="flex items-center justify-between gap-3 border-b border-line px-5 py-3">
            <h2 id="task-entries" class="text-sm font-semibold">Time log</h2>
            <a data-href="/appointments/?assignmentId={id}" href="/appointments/" class="btn btn-ghost btn-sm">All entries<Icon name="arrowRight" /></a>
          </div>
          <ul data-entries class="quiet-scroll max-h-96 divide-y divide-line/70 overflow-y-auto"></ul>
        </section>
      </div>
    </div>
  </div>
</AppLayout>
<script>
  import { mountTaskView } from '../../features/records/task-view';
  import { getStoredToken } from '../../lib/api/http-client';
  let controller = new AbortController();
  const start = () => {
    controller.abort(); controller = new AbortController();
    const root = document.querySelector<HTMLElement>('[data-task-view]')!;
    if (getStoredToken()) void mountTaskView(root, new URLSearchParams(location.search).get('id'), controller.signal);
  };
  start();
  window.addEventListener('pagehide', () => controller.abort());
  window.addEventListener('pageshow', event => { if (event.persisted) start(); });
</script>
