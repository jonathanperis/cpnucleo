---
import Icon from '../../components/Icon.astro';
import { formFields, tableFields } from '../../lib/api/resource-metadata';
import type { ResourceMetadata } from '../../lib/api/types';
import { resourceIcons } from '../../lib/icons';
import { locate } from '../../lib/navigation';
import { PAGE_SIZES } from './list-state';
import { DEFAULT_PAGE_SIZE } from './pagination';
interface Props { resource: ResourceMetadata }
const { resource } = Astro.props;
const fields = formFields(resource);
const columns = tableFields(resource);
const headingId = `${resource.key}-heading`;
const group = locate(resource.routePath)?.group.name;
const plural = resource.pluralLabel.toLowerCase();
---
<section data-crud={resource.key} aria-labelledby={headingId} class="space-y-6">
  <header class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
    <div class="flex items-start gap-4">
      <span class="mt-1 hidden size-11 flex-none items-center justify-center rounded-xl bg-raised text-accent-text ring-1 ring-line-strong sm:flex"><Icon name={resourceIcons[resource.key]} class="size-5" /></span>
      <div>
        {group && <p class="eyebrow">{group}</p>}
        <h1 id={headingId} data-heading tabindex="-1" class="mt-1.5 page-title">{resource.pluralLabel}</h1>
        <p class="mt-1.5 text-[0.9375rem] text-muted">{resource.description}</p>
      </div>
    </div>
    <button type="button" data-action="create" class="btn btn-primary self-start sm:self-auto"><Icon name="plus" />New {resource.label.toLowerCase()}</button>
  </header>

  <p data-permission-note role="note" hidden class="rounded-lg border border-line bg-raised/50 px-4 py-3 text-sm text-muted"></p>
  <p data-error role="alert" hidden class="reveal rounded-lg border border-danger/30 bg-danger/10 px-4 py-3 text-sm text-danger"></p>

  <div data-listing class="panel overflow-hidden">
    <div class="flex flex-wrap items-center gap-2 border-b border-line px-4 py-3 sm:px-5">
      <div class="relative min-w-48 flex-1 sm:max-w-xs">
        <Icon name="search" class="pointer-events-none absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-subtle" />
        <input type="search" data-list-search aria-label={`Search ${plural}`} placeholder={`Search ${plural}…`} maxlength="128" aria-keyshortcuts="/" class="field field-sm pl-8" />
      </div>
      <ul data-filter-chips aria-label="Active filters" class="flex flex-wrap items-center gap-1.5 empty:hidden"></ul>
      <div class="ml-auto flex items-center gap-1">
        <details data-columns-menu class="menu relative">
          <summary class="btn btn-ghost btn-sm list-none [&::-webkit-details-marker]:hidden"><Icon name="columns" />Columns</summary>
          <fieldset class="menu-panel right-0 w-56">
            <legend class="sr-only">Visible columns</legend>
            {columns.map((field, index) => (
              <label class="menu-item"><input type="checkbox" data-column-toggle={field.name} disabled={index === 0} class="checkbox" />{field.label}</label>
            ))}
          </fieldset>
        </details>
        <button type="button" data-action="refresh" class="btn btn-ghost btn-sm" title="Refresh the list"><Icon name="refresh" /><span class="hidden sm:inline">Refresh</span><span class="sr-only sm:hidden">Refresh</span></button>
      </div>
    </div>
    <div data-selection-bar hidden class="flex flex-wrap items-center gap-3 border-b border-line bg-accent/8 px-4 py-2 sm:px-5">
      <p data-selection-count role="status" class="text-[0.8125rem] font-medium"></p>
      <button type="button" data-action="delete-selected" class="btn btn-ghost btn-sm btn-danger"><Icon name="trash" />Delete selected</button>
      <button type="button" data-action="clear-selection" class="btn btn-ghost btn-sm">Clear selection</button>
    </div>
    <div class="flex items-center gap-2.5 border-b border-line/70 px-4 py-2 sm:px-5">
      <p class="flex items-center gap-2.5 text-[0.8125rem] text-muted"><span data-live-dot class="status-dot text-subtle" aria-hidden="true"></span><span data-summary aria-live="polite">Loading records…</span></p>
    </div>
    <div data-empty-state class="px-6 py-14 text-center">
      <span class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full bg-raised text-subtle ring-1 ring-line"><Icon name={resourceIcons[resource.key]} class="size-[1.125rem]" /></span>
      <p data-empty class="text-sm text-muted">Loading records…</p>
      <button type="button" data-action="reset-view" hidden class="btn btn-secondary btn-sm mt-4">Clear search and filters</button>
    </div>
    <div class="quiet-scroll overflow-x-auto"><table data-table hidden class="data-table min-w-full text-sm">
      <caption class="sr-only">{resource.pluralLabel}</caption>
      <thead><tr>
        <th scope="col" data-select-col class="col-select w-px"><input type="checkbox" data-select-all aria-label={`Select every ${resource.label.toLowerCase()} on this page`} class="checkbox" /></th>
        {columns.map(field => <th scope="col" data-col={field.name} class:list={[field.type === 'number' && 'text-right']}><button type="button" data-sort={field.name} class="sort-button">{field.label}<span data-sort-icon aria-hidden="true"></span></button></th>)}
        <th scope="col" class="col-actions w-px text-right"><span class="sr-only">Actions</span></th>
      </tr></thead>
      <tbody data-records></tbody>
    </table></div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line px-4 py-2.5 sm:px-5">
      <label class="flex items-center gap-2 text-[0.8125rem] text-subtle">Rows per page <select data-page-size class="field field-sm w-auto">{PAGE_SIZES.map(size => <option value={size} selected={size === DEFAULT_PAGE_SIZE}>{size}</option>)}</select></label>
      <nav data-pagination aria-label={`${resource.pluralLabel} pages`} class="flex flex-wrap items-center gap-0.5"></nav>
    </div>
  </div>

  <dialog data-form-dialog aria-labelledby={`${resource.key}-form-title`} class="modal sheet">
    <form data-form class="flex max-h-[inherit] flex-col">
      <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-4 sm:px-6">
        <h2 id={`${resource.key}-form-title`} data-form-title class="dialog-title">Create {resource.label}</h2>
        <div class="flex items-center gap-3">
          <p class="hidden text-xs text-subtle sm:block"><span aria-hidden="true" class="text-accent-text">*</span> Required</p>
          <button type="button" data-action="cancel" class="btn btn-ghost btn-icon" aria-label="Close the form"><Icon name="close" /></button>
        </div>
      </div>
      <div class="quiet-scroll flex-1 overflow-y-auto">
        <p data-form-error role="alert" hidden class="mx-5 mt-5 rounded-lg border border-danger/30 bg-danger/10 px-4 py-3 text-sm text-danger sm:mx-6"></p>
        <div class="grid gap-x-5 gap-y-5 px-5 py-5 sm:px-6 md:grid-cols-2">
          {fields.map(field => {
            const id = `${resource.key}-${field.name}`;
            const errorId = `${id}-error`;
            return <div class={field.type === 'textarea' ? 'md:col-span-2' : ''}>
              <label for={id} class="mb-1.5 block text-[0.8125rem] font-medium">{field.label}{field.type === 'datetime-local' ? ' (UTC)' : ''}{field.required ? <span class="text-accent-text"> *</span> : ''}</label>
              {field.relation ? <select id={id} name={field.name} required={field.required} class="field"><option value="">Select {field.label.toLowerCase()}</option></select>
                : field.type === 'textarea' ? <textarea id={id} name={field.name} required={field.required} rows="3" class="field"></textarea>
                : <input id={id} name={field.name} required={field.required} type={field.type === 'guid' ? 'text' : field.type} step={field.type === 'number' ? '1' : undefined} min={field.type === 'number' ? String(field.min ?? 1) : undefined} autocomplete={field.type === 'password' ? 'new-password' : undefined} class="field" />}
              <p id={errorId} data-field-error={field.name} hidden class="mt-1.5 flex items-center gap-1.5 text-[0.8125rem] text-danger"></p>
              {field.relation && <div data-relation={field.relation} data-field={field.name} class="mt-2 space-y-1.5">
                <div data-relation-search hidden class="flex gap-1.5">
                  <div class="relative min-w-0 flex-1">
                    <Icon name="search" class="pointer-events-none absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-subtle" />
                    <input type="search" data-query aria-label={`Filter ${field.label.toLowerCase()} options`} placeholder={`Filter ${field.label.toLowerCase()} options`} maxlength="128" class="field field-sm pl-8" />
                  </div>
                  <button type="button" data-action="more" hidden aria-label={`Load more ${field.label.toLowerCase()} options`} class="btn btn-ghost btn-sm">More</button>
                </div>
                <p data-relation-note hidden class="text-xs leading-relaxed text-subtle"></p>
                <p data-relation-status role="status" class="text-xs text-subtle empty:hidden"></p>
                <p data-relation-error role="alert" class="text-xs text-danger empty:hidden"></p>
              </div>}
            </div>;
          })}
        </div>
      </div>
      <div class="flex flex-wrap justify-end gap-2 border-t border-line bg-raised/30 px-5 py-3.5 sm:px-6">
        <button type="button" data-action="cancel" class="btn btn-ghost">Cancel</button>
        <button type="submit" data-submit="another" class="btn btn-secondary">Save and add another</button>
        <button type="submit" data-submit="close" class="btn btn-primary min-w-24">Save</button>
      </div>
    </form>
  </dialog>

  <dialog data-details aria-labelledby={`${resource.key}-details-title`} class="modal m-auto max-h-[85vh] w-[calc(100%-2rem)] max-w-xl overflow-y-auto">
    <div class="sticky top-0 flex items-center justify-between gap-4 border-b border-line bg-surface px-6 py-4">
      <h2 id={`${resource.key}-details-title`} class="dialog-title">{resource.label} details</h2>
      <button type="button" data-action="close-details" class="btn btn-ghost btn-icon" aria-label="Close"><Icon name="close" /></button>
    </div>
    <dl data-detail-fields class="divide-y divide-line/70 px-6 py-2"></dl>
    <div data-detail-actions hidden class="flex justify-end gap-2 border-t border-line px-6 py-3.5"></div>
  </dialog>

  <dialog data-confirm aria-labelledby={`${resource.key}-confirm-title`} aria-describedby={`${resource.key}-confirm-message`} class="modal m-auto w-[calc(100%-2rem)] max-w-md">
    <div class="flex gap-4 px-6 pb-5 pt-6">
      <span class="flex size-10 flex-none items-center justify-center rounded-full bg-danger/12 text-danger ring-1 ring-danger/25"><Icon name="trash" class="size-[1.125rem]" /></span>
      <div class="min-w-0">
        <h2 id={`${resource.key}-confirm-title`} data-confirm-title class="dialog-title">Delete {resource.label.toLowerCase()}?</h2>
        <p id={`${resource.key}-confirm-message`} data-confirm-message class="mt-1.5 break-words text-sm leading-relaxed text-muted"></p>
      </div>
    </div>
    <div class="flex justify-end gap-2 border-t border-line bg-raised/30 px-6 py-3.5">
      <button type="button" data-confirm-cancel class="btn btn-ghost">Cancel</button>
      <button type="button" data-confirm-accept class="btn btn-danger-solid">Delete</button>
    </div>
  </dialog>
</section>
<script>
  import { mountCrudPage } from './crud-controller';
  import { getStoredToken } from '../../lib/api/http-client';
  for (const root of document.querySelectorAll<HTMLElement>('[data-crud]')) {
    let stop = () => {};
    const start = () => { stop(); if (getStoredToken()) stop = mountCrudPage(root); };
    start();
    window.addEventListener('pagehide', () => stop());
    window.addEventListener('pageshow', event => { if (event.persisted) start(); });
  }
</script>
