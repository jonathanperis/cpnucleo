---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '../../styles/docs.css';
import { SECTION_CATEGORIES, SECTION_ORDER } from '../../lib/sidebar.config';

const SLUG_LABEL: Record<string, string> = {
  home: 'Home',
  architecture: 'Architecture',
  'api-reference': 'API Reference',
  database: 'Database',
  'getting-started': 'Getting Started',
  'project-structure': 'Project Structure',
  technologies: 'Technologies',
  testing: 'Testing',
  deployment: 'Deployment',
};

const DOC_SUMMARIES: Record<string, string> = {
  home: 'Project overview, feature map, and repository entry points.',
  architecture: 'Layer boundaries, Clean Architecture constraints, and service split.',
  'api-reference': 'REST endpoints, Identity API, and gRPC command contracts.',
  database: 'PostgreSQL setup, EF Core, Dapper, migrations, and seed scripts.',
  'getting-started': 'Prerequisites, local build, Docker Compose, and first run path.',
  'project-structure': 'Repository tree, source projects, tests, infrastructure, and docs.',
  technologies: 'Runtime, libraries, infrastructure, observability, and deployment stack.',
  testing: 'Architecture tests, unit tests, integration tests, and coverage workflow.',
  deployment: 'Docker, GHCR, GitHub Actions, NGINX, Azure, and release pipeline.'
};

const globResult = import.meta.glob('../../../wiki/*.md', { eager: true });

const pagesBySlug: Record<string, any> = {};
for (const [path, module] of Object.entries(globResult)) {
  const fileName = path.split('/').pop()!.replace('.md', '');
  pagesBySlug[fileName] = module;
}

const availableSlugs = new Set(Object.keys(pagesBySlug));
for (const cat of SECTION_CATEGORIES) {
  for (const id of cat.ids) {
    if (!availableSlugs.has(id)) {
      const catName = cat.label || 'root';
      throw new Error(
        `SECTION_CATEGORIES references id "${id}" (category: "${catName}") but no matching wiki/${id}.md was found. Available slugs: ${Array.from(availableSlugs).join(', ')}`
      );
    }
  }
}

const requestedSlug = Astro.params.slug;
const isRoot = requestedSlug === undefined;
const requestedKey = requestedSlug ?? 'home';
const selectedPage = pagesBySlug[requestedKey];
const sectionsToRender = !isRoot && selectedPage ? [{ slug: requestedKey, page: selectedPage }] : [];

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    ...SECTION_ORDER.filter(s => s !== 'home').map(slug => ({ params: { slug } })),
  ];
}

const pageTitle = isRoot ? 'cpnucleo - Documentation' : `${SLUG_LABEL[requestedKey] ?? requestedKey} - cpnucleo`;
const base = import.meta.env.BASE_URL;
const docsBase = base.replace(/\/$/, '') + '/docs';
const backHomeUrl = base.replace(/\/$/, '') + '/';
const currentId = isRoot ? 'home' : requestedKey;
const docsGroups = SECTION_CATEGORIES.map((cat) => ({
  label: cat.label || 'Start',
  ids: cat.ids,
}));
---

<BaseLayout title={pageTitle}>
  <div class="mobile-header">
    <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-controls="sidebar" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="repo-title">cpnucleo</div>
  </div>

  <div class="overlay" id="overlay"></div>

  <aside class="sidebar" id="sidebar" data-current-id={currentId}>
    <div class="sidebar-header">
      <a class="repo-title" href={docsBase + '/'}>cpnucleo</a>
      <p class="repo-description">.NET 10 Clean Architecture reference with REST, gRPC, Blazor, PostgreSQL, and Azure deployment.</p>
      <input type="text" id="searchInput" class="search-box" placeholder="Filter documentation" aria-label="Filter documentation" />
      <p class="search-empty" id="searchEmpty" role="status" hidden>No docs entry matches that filter.</p>
    </div>
    <div class="sidebar-nav-container">
      {SECTION_CATEGORIES.map((cat) => (
        <div class="sidebar-category-group" data-category>
          {cat.label && <div class="sidebar-category">{cat.label}</div>}
          <ul>
            {cat.ids.map((id) => {
              const href = id === 'home' ? `${docsBase}/` : `${docsBase}/${id}/`;
              return (
                <li>
                  <a class:list={["nav-item", currentId === id && "active"]} href={href} data-nav-id={id} data-search-text={`${SLUG_LABEL[id]} ${DOC_SUMMARIES[id]}`}>
                    {SLUG_LABEL[id]}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
    <div class="sidebar-footer">
      <a href={backHomeUrl} class="back-home">Back to home</a>
      <a href="https://github.com/jonathanperis/cpnucleo" target="_blank" rel="noopener noreferrer">View on GitHub</a>
      <div>Built by Jonathan Peris</div>
    </div>
  </aside>

  <div class="content-wrapper">
    <main class="content" id="mainContent">
      {isRoot ? (
        <section class="docs-command" aria-labelledby="docs-title">
          <p class="eyebrow">documentation command center</p>
          <h1 id="docs-title">Choose the proof trail you need</h1>
          <p class="lead">The docs are grouped for architecture review, implementation study, and deployment checks. Start with the route that matches your question instead of scanning one compiled page.</p>

          <div class="docs-group-grid">
            {docsGroups.map((group) => (
              <section class="docs-group" data-doc-group>
                <h2>{group.label}</h2>
                <div class="docs-link-list">
                  {group.ids.map((id) => {
                    const href = id === 'home' ? `${docsBase}/` : `${docsBase}/${id}/`;
                    return (
                      <a class="docs-link-card" href={href} data-search-text={`${SLUG_LABEL[id]} ${DOC_SUMMARIES[id]}`}>
                        <span>{SLUG_LABEL[id]}</span>
                        <p>{DOC_SUMMARIES[id]}</p>
                      </a>
                    );
                  })}
                </div>
              </section>
            ))}
          </div>
        </section>
      ) : (
        sectionsToRender.map(({ slug, page: wikiPage }) => {
          const Content = wikiPage.default ?? wikiPage;
          return (
            <section id={slug} class="doc-section">
              <Content />
            </section>
          );
        })
      )}
    </main>
  </div>

  <script is:inline define:vars={{ currentId: currentId }}>
    document.addEventListener('DOMContentLoaded', () => {
      const menuToggle = document.getElementById('menuToggle');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');

      function setMenu(open) {
        sidebar.classList.toggle('open', open);
        overlay.classList.toggle('open', open);
        if (menuToggle) menuToggle.setAttribute('aria-expanded', String(open));
      }

      if (menuToggle) menuToggle.addEventListener('click', () => setMenu(!sidebar.classList.contains('open')));
      if (overlay) overlay.addEventListener('click', () => setMenu(false));

      document.querySelectorAll('.nav-item').forEach((item) => {
        item.classList.toggle('active', item.dataset.navId === currentId);
        item.addEventListener('click', () => {
          if (window.innerWidth <= 768) setMenu(false);
        });
      });

      const searchInput = document.getElementById('searchInput');
      const searchEmpty = document.getElementById('searchEmpty');
      const searchable = Array.from(document.querySelectorAll('[data-search-text]'));
      const groups = Array.from(document.querySelectorAll('[data-category], [data-doc-group]'));

      if (searchInput) {
        searchInput.addEventListener('input', (event) => {
          const query = event.target.value.toLowerCase().trim();
          let visible = 0;

          searchable.forEach((item) => {
            const match = !query || item.dataset.searchText.toLowerCase().includes(query);
            const container = item.closest('li') || item;
            container.hidden = !match;
            if (match) visible++;
          });

          groups.forEach((group) => {
            const entries = Array.from(group.querySelectorAll('[data-search-text]'));
            group.hidden = entries.length > 0 && entries.every((entry) => (entry.closest('li') || entry).hidden);
          });

          if (searchEmpty) searchEmpty.hidden = query === '' || visible > 0;
        });
      }
    });
  </script>
</BaseLayout>
