---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Mark from '@/components/Mark.astro';
import Contents from '@/components/Contents.astro';
import '../../styles/docs.css';
import { DOC_SUMMARIES, SECTION_CATEGORIES, SECTION_ORDER, SLUG_LABEL, chapterNumber } from '../../lib/sidebar.config';

const globResult = import.meta.glob('../../../wiki/*.md', { eager: true });

const pagesBySlug: Record<string, any> = {};
for (const [path, module] of Object.entries(globResult)) {
  const fileName = path.split('/').pop()!.replace('.md', '');
  pagesBySlug[fileName] = module;
}

const availableSlugs = new Set(Object.keys(pagesBySlug));
for (const cat of SECTION_CATEGORIES) {
  for (const id of cat.ids) {
    if (!availableSlugs.has(id)) {
      throw new Error(
        `SECTION_CATEGORIES references id "${id}" (category: "${cat.label}") but no matching wiki/${id}.md was found. Available slugs: ${Array.from(availableSlugs).join(', ')}`
      );
    }
  }
}

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    ...SECTION_ORDER.map(slug => ({ params: { slug } })),
  ];
}

const requestedSlug = Astro.params.slug;
const isRoot = requestedSlug === undefined;
const currentId = isRoot ? '' : requestedSlug;
const page = isRoot ? undefined : pagesBySlug[currentId];
const Content = page?.default;
const headings: { depth: number; slug: string; text: string }[] = page?.getHeadings?.() ?? [];
const sections = headings.filter((heading) => heading.depth === 2);

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docsBase = `${base}/docs`;
const position = SECTION_ORDER.indexOf(currentId);
const previous = position > 0 ? SECTION_ORDER[position - 1] : undefined;
const next = position >= 0 && position < SECTION_ORDER.length - 1 ? SECTION_ORDER[position + 1] : undefined;
const partIndex = SECTION_CATEGORIES.findIndex((category) => (category.ids as readonly string[]).includes(currentId));
const parts = ['I', 'II', 'III', 'IV'];

const pageTitle = isRoot ? 'Documentation | Cpnucleo' : `${SLUG_LABEL[currentId] ?? currentId} | Cpnucleo`;
---

<BaseLayout title={pageTitle} description={isRoot ? 'Eleven chapters on how the Cpnucleo .NET laboratory is built, tested and shipped.' : DOC_SUMMARIES[currentId]}>
  <a class="skip-link" href="#mainContent">Skip to content</a>

  <div class="mobile-header">
    <button class="menu-toggle" id="menuToggle" aria-label="Contents" aria-controls="sidebar" aria-expanded="false">
      <span></span>
      <span></span>
    </button>
    <a class="wordmark" href={`${base}/`}><Mark size={22} />Cpnucleo</a>
  </div>

  <div class="overlay" id="overlay"></div>

  <div class="docs">
    <aside class="sidebar" id="sidebar" data-current-id={currentId}>
      <div class="sidebar-header">
        <a class="wordmark" href={`${base}/`}><Mark />Cpnucleo</a>
        <a class="rail-title" href={`${docsBase}/`} aria-current={isRoot ? 'page' : undefined}>Documentation</a>
        <label class="search" for="searchInput">
          <span class="visually-hidden">Filter documentation</span>
          <input type="search" id="searchInput" class="search-box" placeholder="Filter chapters" autocomplete="off" />
        </label>
        <p class="search-empty" id="searchEmpty" role="status" hidden>No chapter matches that filter.</p>
      </div>
      <nav class="sidebar-nav-container" aria-label="Chapters">
        {SECTION_CATEGORIES.map((cat, index) => (
          <div class="sidebar-category-group" data-category>
            <p class="sidebar-category"><span>Part {parts[index]}</span>{cat.label}</p>
            <ol>
              {cat.ids.map((id) => (
                <li>
                  <a class:list={["nav-item", currentId === id && "active"]} href={`${docsBase}/${id}/`} aria-current={currentId === id ? 'page' : undefined} data-nav-id={id} data-search-text={`${SLUG_LABEL[id]} ${DOC_SUMMARIES[id]}`}>
                    <span class="num">{chapterNumber(id)}</span>{SLUG_LABEL[id]}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </nav>
      <div class="sidebar-footer">
        <a href="https://github.com/jonathanperis/cpnucleo">Source on GitHub</a>
        <a href="https://cpnucleo.jonathanperis.tech/" target="_blank" rel="noopener noreferrer">Live demo</a>
      </div>
    </aside>

    <main class="content" id="mainContent">
      {isRoot ? (
        <section class="docs-index" aria-labelledby="docs-title">
          <p class="running-head"><span>Cpnucleo documentation</span><span>{SECTION_ORDER.length} chapters</span></p>
          <h1 id="docs-title">Contents</h1>
          <p class="lead">How Cpnucleo is built, tested and shipped. Start with the overview or the learning lab; the other chapters work as reference and can be read in any order.</p>
          <Contents headingLevel="h2" />
        </section>
      ) : (
        <>
          <p class="running-head">
            <span>Part {parts[partIndex]}, {SECTION_CATEGORIES[partIndex]?.label}</span>
            <span>Chapter {chapterNumber(currentId)} of {SECTION_ORDER.length}</span>
          </p>
          <article id={currentId} class="doc-section prose">
            {Content && <Content />}
          </article>
          <nav class="pager" aria-label="Chapters">
            {previous ? (
              <a class="pager-link" href={`${docsBase}/${previous}/`} rel="prev">
                <span class="pager-label">← Previous, {chapterNumber(previous)}</span>
                <span class="pager-title">{SLUG_LABEL[previous]}</span>
              </a>
            ) : <span></span>}
            {next ? (
              <a class="pager-link next" href={`${docsBase}/${next}/`} rel="next">
                <span class="pager-label">Next, {chapterNumber(next)} →</span>
                <span class="pager-title">{SLUG_LABEL[next]}</span>
              </a>
            ) : <span></span>}
          </nav>
        </>
      )}
      <footer class="docs-colophon">
        <p>Cpnucleo by <a href="https://github.com/jonathanperis">Jonathan Peris</a>, MIT licence. Set in Newsreader and IBM Plex.</p>
      </footer>
    </main>

    {sections.length > 1 && (
      <aside class="toc" aria-labelledby="toc-title">
        <p class="toc-title" id="toc-title">On this page</p>
        <ol>
          {sections.map((heading) => <li><a href={`#${heading.slug}`} data-toc-link={heading.slug}>{heading.text}</a></li>)}
        </ol>
      </aside>
    )}
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const menuToggle = document.getElementById('menuToggle');
      const sidebar = document.getElementById('sidebar');
      const overlay = document.getElementById('overlay');

      function setMenu(open) {
        sidebar.classList.toggle('open', open);
        overlay.classList.toggle('open', open);
        if (menuToggle) menuToggle.setAttribute('aria-expanded', String(open));
      }

      if (menuToggle) menuToggle.addEventListener('click', () => setMenu(!sidebar.classList.contains('open')));
      if (overlay) overlay.addEventListener('click', () => setMenu(false));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && sidebar.classList.contains('open')) {
          setMenu(false);
          menuToggle?.focus();
        }
      });

      document.querySelectorAll('.nav-item').forEach((item) => {
        item.addEventListener('click', () => {
          if (window.innerWidth <= 860) setMenu(false);
        });
      });

      const searchInput = document.getElementById('searchInput');
      const searchEmpty = document.getElementById('searchEmpty');
      const searchable = Array.from(document.querySelectorAll('[data-search-text]'));
      const groups = Array.from(document.querySelectorAll('[data-category], [data-doc-group]'));

      if (searchInput) {
        searchInput.addEventListener('input', (event) => {
          const query = event.target.value.toLowerCase().trim();
          let visible = 0;

          searchable.forEach((item) => {
            const match = !query || item.dataset.searchText.toLowerCase().includes(query);
            const container = item.closest('li') || item;
            container.hidden = !match;
            if (match && item.closest('#sidebar')) visible++;
          });

          groups.forEach((group) => {
            const entries = Array.from(group.querySelectorAll('[data-search-text]'));
            group.hidden = entries.length > 0 && entries.every((entry) => (entry.closest('li') || entry).hidden);
          });

          if (searchEmpty) searchEmpty.hidden = query === '' || visible > 0;
        });
      }

      // Marks the section being read in the "On this page" margin.
      const tocLinks = new Map(Array.from(document.querySelectorAll('[data-toc-link]')).map((link) => [link.dataset.tocLink, link]));
      if (tocLinks.size > 0 && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            tocLinks.forEach((link) => link.removeAttribute('aria-current'));
            tocLinks.get(entry.target.id)?.setAttribute('aria-current', 'true');
          });
        }, { rootMargin: '0px 0px -70% 0px' });
        tocLinks.forEach((_, id) => {
          const heading = document.getElementById(id);
          if (heading) observer.observe(heading);
        });
      }
    });
  </script>
</BaseLayout>
