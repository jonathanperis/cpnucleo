---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Masthead from '@/components/Masthead.astro';
import Colophon from '@/components/Colophon.astro';
import Contents from '@/components/Contents.astro';
import ServiceMap from '@/components/home/ServiceMap.astro';

const title = 'Cpnucleo | a .NET 10 architecture laboratory';
const description = 'One project tracker, built several ways: REST and gRPC, EF Core and Dapper, an OpenID Connect provider and an Astro client on PostgreSQL, with tests for each claim.';
const docsBase = import.meta.env.BASE_URL.replace(/\/$/, '') + '/docs';

const ledger = [
  {
    title: 'REST and gRPC over one model',
    body: 'WebApi serves FastEndpoints REST and GrpcServer answers FastEndpoints Remote Messaging. Both expose the same CRUD operations, with a verified parity example.',
    more: 'API reference',
    href: `${docsBase}/api-reference/`,
  },
  {
    title: 'EF Core beside Dapper',
    body: 'REST shows EF Core, an explicit Dapper repository and a generic Dapper unit of work; gRPC uses Dapper. PostgreSQL triggers keep soft deletes consistent for every writer.',
    more: 'Database',
    href: `${docsBase}/database/`,
  },
  {
    title: 'Boundaries that fail the build',
    body: 'Architecture tests load the real assemblies and fail when the Domain reaches for infrastructure or one transport host references the other.',
    more: 'Testing',
    href: `${docsBase}/testing/`,
  },
  {
    title: 'Its own OpenID Connect provider',
    body: 'IdentityApi signs RS256 access tokens through the authorization code flow with PKCE. The APIs hold no keys; they read the published key set.',
    more: 'Architecture',
    href: `${docsBase}/architecture/`,
  },
  {
    title: 'Tested images, then Hostinger',
    body: 'GitHub Actions tests immutable amd64 images, deploys through Hostinger Docker Manager, smoke-tests production and only then publishes multi-arch manifests.',
    more: 'Deployment',
    href: `${docsBase}/deployment/`,
  },
];
---

<BaseLayout title={title} description={description}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Masthead />

  <main id="main" class="home">
    <section class="hero" aria-labelledby="hero-title">
      <div>
        <h1 id="hero-title">One project tracker, <em>built several ways.</em></h1>
        <p class="lede">Cpnucleo is a .NET 10 laboratory. The same project-management domain is served over REST and gRPC, stored through EF Core and Dapper, guarded by its own OpenID Connect provider and used from a plain Astro client, so each choice can be read, run and compared.</p>
        <div class="actions" data-analytics-scope="hero">
          <a class="button" href={`${docsBase}/`} data-track="docs">Read the documentation <span class="arrow" aria-hidden="true">→</span></a>
          <a class="text-link" href="https://github.com/jonathanperis/cpnucleo" data-track="github">Inspect the source</a>
          <a class="text-link" href="https://cpnucleo.jonathanperis.tech/" target="_blank" rel="noopener noreferrer" data-track="demo">Open the live demo</a>
        </div>
      </div>
      <ServiceMap />
    </section>

    <section class="section" aria-labelledby="compare-title">
      <div class="section-head">
        <p class="kicker"><span class="num">§1</span>What it compares</p>
        <h2 id="compare-title">Built to be compared, not admired.</h2>
        <p>Each entry names the code behind it and the chapter that explains it.</p>
      </div>
      <ol class="ledger">
        {ledger.map((row, index) => (
          <li>
            <a href={row.href}>
              <span class="num">1.{index + 1}</span>
              <strong>{row.title}</strong>
              <p>{row.body}</p>
              <span class="more">{row.more} →</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="section" aria-labelledby="contents-title">
      <div class="section-head">
        <p class="kicker"><span class="num">§2</span>Contents</p>
        <h2 id="contents-title">Eleven chapters, read in any order.</h2>
        <p>Start with the overview or the learning lab. The rest work as reference.</p>
      </div>
      <Contents />
    </section>

    <section class="section" aria-labelledby="run-title">
      <div class="section-head">
        <p class="kicker"><span class="num">§3</span>Run it</p>
        <h2 id="run-title">Run the lab on your own machine.</h2>
        <p>You need Docker. The seed step loads disposable example data and never touches production.</p>
      </div>
      <div>
        <ol class="steps">
          <li><span>Clone the repository and start the minimal lab profile.</span></li>
          <li><span>Seed it with example projects, people and time records.</span></li>
          <li><span>Sign in as <code>demo@cpnucleo.local</code> with the password from Getting Started.</span></li>
        </ol>
        <figure class="listing">
          <figcaption><span><b>Listing 1.</b> The minimal lab</span><span>terminal</span></figcaption>
          <pre tabindex="0"><code><span class="p">$ </span>git clone https://github.com/jonathanperis/cpnucleo
<span class="p">$ </span>cd cpnucleo
<span class="p">$ </span>docker compose -f compose.lab.yaml up --build -d
<span class="p">$ </span>docker compose -f compose.lab.yaml run --rm seed
<span class="c"># then open http://localhost:5400</span></code></pre>
        </figure>
        <p class="after">Profiles for the full stack and observability, and the settings for running from source, are in <a class="text-link" href={`${docsBase}/getting-started/`}>Getting Started</a>.</p>
      </div>
    </section>
  </main>

  <Colophon />

  <script is:inline>
    document.querySelectorAll('[data-track]').forEach((link) => {
      link.addEventListener('click', () => {
        window.gtag?.('event', 'cpnucleo_cta_click', { cta: link.dataset.track });
      });
    });
  </script>
</BaseLayout>
