---
import '../styles/globals.css';
import Analytics from '../components/Analytics.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'cpnucleo | .NET architecture workbench',
  description = 'Source-backed documentation for a .NET 10 Clean Architecture reference system with REST, gRPC, Blazor, PostgreSQL, Docker, Hostinger, and automated architecture tests.'
} = Astro.props;

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : `https://jonathanperis.github.io${Astro.url.pathname}`;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const assetPath = (path: string) => `${basePath}/${path.replace(/^\//, '')}`;
const absoluteAsset = (path: string) => new URL(assetPath(path), Astro.site ?? 'https://jonathanperis.github.io').href;
const faviconHref = assetPath('favicon.ico');
const faviconPngHref = assetPath('favicon.png');
const favicon32Href = assetPath('favicon-32x32.png');
const appleTouchIconHref = assetPath('apple-touch-icon.png');
const socialImageUrl = absoluteAsset('social-preview.png');
const thumbnailHref = assetPath('thumbnail.png');
const thumbnailUrl = absoluteAsset('thumbnail.png');
const socialImageAlt = 'CPnucleo dark cyan architecture workbench preview with .NET service topology';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  'name': 'cpnucleo',
  'description': description,
  'url': pageUrl,
  'image': socialImageUrl,
  'codeRepository': 'https://github.com/jonathanperis/cpnucleo',
  'programmingLanguage': 'C#',
  'runtimePlatform': '.NET 10',
  'license': 'https://github.com/jonathanperis/cpnucleo/blob/main/LICENSE',
  'author': {
    '@type': 'Person',
    'name': 'Jonathan Peris',
    'url': 'https://jonathanperis.github.io/'
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=JetBrains+Mono:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet" />
    <meta name="description" content={description} />
    <meta name="keywords" content=".NET 10, Clean Architecture, CQRS, DDD, FastEndpoints, Blazor, Hostinger, gRPC, PostgreSQL, Docker, C#" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" href={faviconHref} sizes="any" />
    <link rel="icon" type="image/png" href={faviconPngHref} />
    <link rel="icon" type="image/png" sizes="32x32" href={favicon32Href} />
    <link rel="apple-touch-icon" href={appleTouchIconHref} />
    <link rel="image_src" href={socialImageUrl} />
    <link rel="thumbnail" href={thumbnailHref} />
    <meta name="theme-color" content="#061427" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="cpnucleo" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="twitter:creator" content="@jperis_silva" />
    <meta name="thumbnail" content={thumbnailUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
